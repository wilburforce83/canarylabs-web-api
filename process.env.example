# Canary Web API endpoint (the HTTPS Web API port, usually 55236)
MY_BASE_URL=https://yourdomain.canarylabs.online:55236/api/v2

# Option 1 (recommended): API token from Canary Admin > Identity > Security > API Tokens.
# When set, it is used instead of the username and password.
MY_TOKEN=my_api_token

# Option 2: username and password (getUserToken login)
MY_USERNAME=my_username_value
MY_PASSWORD=my_password_value
